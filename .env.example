# --- App --------------------------------------------------------------
APP_ENV=local
APP_DEBUG=false
APP_URL=https://paint.elonn.local

# --- Database ---------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elonn_paint
DB_USERNAME=elonn_paint
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Storage service --------------------------------------------------
STORAGE_BASE_URL=https://storage.elonn.local
STORAGE_RESOURCE_URL=https://storage.elonn.local/resources
STORAGE_TIMEOUT_SECONDS=8
ELONN_STORAGE_SERVICE_CALLER=paint.elonn
ELONN_PAINT_STORAGE_TOKEN=

# --- Service authentication ------------------------------------------
# Shared secret for this pair -- same key, same value, in mind.elonn.com's
# own .env.
ELONN_MIND_PAINT_TOKEN=

# Optional Operations Center access.
ELONN_ADMIN_PAINT_TOKEN=

# Conductor signed-request verification.
# Derived automatically from APP_ENV (conductor.elonn.local / conductor.elonn.com) -- only set this
# if Conductor's real address ever needs to be pinned to something else.
# CONDUCTOR_SERVICE_KEYS_URL=
