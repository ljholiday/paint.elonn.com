# --- App --------------------------------------------------------------
APP_ENV=local
APP_DEBUG=false
APP_URL=https://paint.elonn.local

# --- Database ---------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elonn_paint
DB_USERNAME=elonn_paint
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Storage service --------------------------------------------------
STORAGE_BASE_URL=https://storage.elonn.local
STORAGE_RESOURCE_URL=https://storage.elonn.local/resources
STORAGE_TIMEOUT_SECONDS=8
ELONN_STORAGE_SERVICE_CALLER=paint.elonn
ELONN_STORAGE_SERVICE_TOKEN=

# --- Service authentication ------------------------------------------
# Must match mind.elonn.local's ELONN_PAINT_SERVICE_TOKEN exactly.
ELONN_MIND_SERVICE_TOKEN=

# Optional Operations Center access.
ELONN_ADMIN_SERVICE_TOKEN=

# Conductor signed-request verification.
CONDUCTOR_SERVICE_KEYS_URL=https://conductor.elonn.local/.well-known/elonn-service-keys.json
